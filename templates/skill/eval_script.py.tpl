# Local Agent Judge
# ═══════════════════════════════════════════════════════
class LocalAgentJudge(BaseMetric):
    def __init__(self, name, criteria, threshold=0.7, agent_cmd="claude"):
        self.threshold = threshold; self._name = name
        self.criteria = criteria; self.agent_cmd = agent_cmd
        self.evaluation_model = f"local-agent:{agent_cmd}"
    @property
    def __name__(self): return self._name
    def measure(self, test_case, *args, **kwargs):
        prompt = f"""你是一名严格的评测员。请评估以下回答的质量。

评测标准: {self.criteria}

期望输出: {test_case.expected_output or '(无)'}

实际输出: {test_case.actual_output or '(无)'}

请仅输出一个 JSON 对象，不要任何解释：
{{"score": 0~1 之间的浮点数, "reason": "简短中文说明"}}"""
        try:
            r = subprocess.run([self.agent_cmd, "-p", prompt], capture_output=True, text=True, timeout=120)
            out = r.stdout.strip() or r.stderr.strip()
            m = re.search(r'\{[\s\S]*\}', out)
            if m:
                p = json.loads(m.group())
                self.score = float(p.get("score", 0)); self.reason = p.get("reason", out[:200])
            else: self.score = 0.0; self.reason = f"无法解析: {out[:200]}"
        except subprocess.TimeoutExpired: self.score = 0.0; self.reason = "超时"
        except FileNotFoundError: self.score = 0.0; self.reason = f"未找到 '{self.agent_cmd}'"
        except Exception as e: self.score = 0.0; self.reason = str(e)
        self.success = self.score >= self.threshold; return self.score
    async def a_measure(self, test_case, *args, **kwargs): return self.measure(test_case)
    def is_successful(self): return bool(self.score and self.score >= self.threshold)

