class LocalAgentJudge(BaseMetric):
    """用本地 Agent CLI 作为评委，逐条打分"""

    def __init__(self, name: str, criteria: str, threshold: float = 0.7, agent_cmd: str = "claude"):
        self.threshold = threshold
        self._name = name
        self.criteria = criteria
        self.agent_cmd = agent_cmd
        self.evaluation_model = f"local-agent:{agent_cmd}"

    @property
    def __name__(self):
        return self._name

    def measure(self, test_case: LLMTestCase, *args, **kwargs) -> float:
        prompt = f"""你是一名严格的评测员。请评估以下回答的质量。

评测标准: {self.criteria}

期望输出: {test_case.expected_output or '(无)'}

实际输出: {test_case.actual_output or '(无)'}

请仅输出一个 JSON 对象，不要任何解释：
{{
  "score": 0~1 之间的浮点数,
  "reason": "简短中文说明"
}}"""

        try:
            result = subprocess.run(
                [self.agent_cmd, "-p", prompt],
                capture_output=True, text=True, timeout=120
            )
            output = result.stdout.strip()
            if not output:
                output = result.stderr.strip()

            json_match = re.search(r'\{[\s\S]*\}', output)
            if json_match:
                parsed = json.loads(json_match.group())
                self.score = float(parsed.get("score", 0))
                self.reason = parsed.get("reason", output[:200])
            else:
                self.score = 0.0
                self.reason = f"Agent 返回无法解析: {output[:200]}"
        except subprocess.TimeoutExpired:
            self.score = 0.0
            self.reason = "Agent 调用超时"
        except FileNotFoundError:
            self.score = 0.0
            self.reason = f"未找到 Agent 命令 '{self.agent_cmd}'，请确认已安装"
        except Exception as e:
            self.score = 0.0
            self.reason = f"Agent 调用异常: {e}"

        self.success = self.score >= self.threshold
        return self.score

    async def a_measure(self, test_case: LLMTestCase, *args, **kwargs) -> float:
        return self.measure(test_case)

    def is_successful(self) -> bool:
        return bool(self.score and self.score >= self.threshold)

