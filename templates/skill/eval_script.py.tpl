def main():
    test_cases = load_test_cases()
    gate_metrics = build_gate_metrics()
    score_metrics = build_score_metrics()

    print(f"Judge Mode: {JUDGE_MODE}")
    print(f"Gate metrics: {len(gate_metrics)}, Score metrics: {len(score_metrics)}")
    print(f"Test cases: {len(test_cases)}")

    all_results = []

    for case_idx, test_case in enumerate(test_cases):
        print(f"\n{'='*60}")
        print(f"Case {case_idx+1}: {test_case.input[:60]}...")
        case_result = {"case": case_idx + 1, "input": test_case.input, "gate_passed": True, "gate_failed_at": None, "scores": [], "final_score": None}

        # 阶段 1：门禁检查（顺序执行，不通过则停止）
        if gate_metrics:
            gate_passed = True
            for i, metric in enumerate(gate_metrics):
                try:
                    evaluate([test_case], [metric], run_async=False)
                    if not metric.is_successful():
                        print(f"  [GATE FAIL] {metric.__name__}: score={metric.score:.3f}, threshold={metric.threshold}")
                        case_result["gate_passed"] = False
                        case_result["gate_failed_at"] = metric.__name__
                        gate_passed = False
                        break
                    else:
                        print(f"  [GATE PASS] {metric.__name__}: score={metric.score:.3f}")
                except Exception as e:
                    print(f"  [GATE ERROR] {metric.__name__}: {e}")
                    case_result["gate_passed"] = False
                    case_result["gate_failed_at"] = metric.__name__
                    gate_passed = False
                    break

            if not gate_passed:
                case_result["final_score"] = "N/A (门禁未通过)"
                all_results.append(case_result)
                continue

        # 阶段 2：打分评测（全部执行，加权平均）
        if score_metrics:
            evaluate([test_case], score_metrics, run_async=False)
            weighted_sum = 0.0
            total_weight = 0.0
            for i, metric in enumerate(score_metrics):
                raw_score = metric.score or 0.0
                strictness = SCORE_STRICTNESS[i] if i < len(SCORE_STRICTNESS) else 1.0
                adjusted = math.pow(raw_score, strictness)
                weight = SCORE_WEIGHTS[i] if i < len(SCORE_WEIGHTS) else 0.3
                weighted_sum += adjusted * weight
                total_weight += weight
                case_result["scores"].append({
                    "name": metric.__name__,
                    "raw_score": round(raw_score, 4),
                    "strictness": strictness,
                    "adjusted_score": round(adjusted, 4),
                    "weight": weight,
                    "reason": getattr(metric, 'reason', ''),
                })
                print(f"  [SCORE] {metric.__name__}: raw={raw_score:.3f}, strictness={strictness}, adjusted={adjusted:.3f}, weight={weight}")

            final_score = round(weighted_sum / total_weight, 4) if total_weight > 0 else 0.0
            case_result["final_score"] = final_score
            print(f"  => Final weighted score: {final_score}")
        else:
            case_result["final_score"] = "N/A (无打分指标)"

        all_results.append(case_result)

    # 输出 JSON 报告
    report = {
        "skill": "{{skillName}}",
        "judge_mode": JUDGE_MODE,
        "n_cases": len(test_cases),
        "gate_count": len(gate_metrics),
        "score_count": len(score_metrics),
        "score_weights": SCORE_WEIGHTS,
        "score_strictness": SCORE_STRICTNESS,
        "results": all_results,
    }
    report_path = "eval_report.json"
    with open(report_path, "w", encoding="utf-8") as f:
        json.dump(report, f, ensure_ascii=False, indent=2)
    print(f"\nReport saved to {report_path}")

if __name__ == "__main__":
    main()